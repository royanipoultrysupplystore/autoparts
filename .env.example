# =====================================================================
# Mahmood Shah Auto Recycler -- environment
#
# Copy to .env.local and fill in. .env.local is git-ignored and must
# never be committed: the service role key below bypasses every Row
# Level Security policy in the database.
# =====================================================================

# --- Supabase -------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by `npm run seed` and `npm run seed:users`.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public storefront ----------------------------------------------
# Leave false until the yard is ready to face the public. When false the
# /shop route returns 404. The data layer behind it only ever reads
# published parts and carries no cost data either way.
NEXT_PUBLIC_ENABLE_STOREFRONT=false

# Shown on the storefront so buyers know how to reach the yard.
NEXT_PUBLIC_SHOP_CONTACT_PHONE=
NEXT_PUBLIC_SHOP_CONTACT_EMAIL=

# --- Team bootstrap (used by `npm run seed:users` only) --------------
# Four partners, one of them the owner. Passwords are temporary --
# everyone should change theirs after the first sign-in.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=

SEED_PARTNER_2_EMAIL=
SEED_PARTNER_2_NAME=
SEED_PARTNER_2_PASSWORD=

SEED_PARTNER_3_EMAIL=
SEED_PARTNER_3_NAME=
SEED_PARTNER_3_PASSWORD=

SEED_PARTNER_4_EMAIL=
SEED_PARTNER_4_NAME=
SEED_PARTNER_4_PASSWORD=
