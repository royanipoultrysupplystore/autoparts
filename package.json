{
  "name": "mahmood-shah-auto-recycler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:catalog": "tsx scripts/seed.ts --catalog-only",
    "seed:demo": "tsx scripts/seed.ts --demo",
    "seed:clear-demo": "tsx scripts/seed.ts --clear-demo",
    "seed:users": "tsx scripts/seed-users.ts",
    "db:push": "supabase db push",
    "icons:generate": "tsx scripts/generate-pwa-icons.ts",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run db:verify",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-migrate.ts --status",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "team": "tsx scripts/seed-users.ts --list",
    "verify:live": "npm run db:check && npm run db:smoke"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
